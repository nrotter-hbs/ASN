// Microsoft Sentinel: IPv4/IPv6 prefix -> ASN -> organization + malicious ASN intelligence.
let IPToCheck = "2607:fb91:44::1";
let MaliciousASN = externaldata(
    asn:string, organization:string, malicious:bool, confidence:string,
    category:string, source:string, source_url:string, last_seen:datetime
)["https://raw.githubusercontent.com/nrotter-hbs/ASN/main/data/malicious_asns.csv"]
with (format="csv", ignoreFirstRecord=true);
let IPv6ASN = externaldata(
    prefix:string, mask_length:int, ip_version:int, asn:string,
    organization:string, country:string, hits:long
)["https://raw.githubusercontent.com/nrotter-hbs/ASN/main/data/ipv6_ownership.csv"]
with (format="csv", ignoreFirstRecord=true);
let IPv4ASN = externaldata(
    prefix:string, mask_length:int, ip_version:int, asn:string,
    organization:string, country:string, hits:long
)["https://raw.githubusercontent.com/nrotter-hbs/ASN/main/data/ipv4_ownership.csv"]
with (format="csv", ignoreFirstRecord=true);
let PrefixMatch = union
    (IPv6ASN | where ipv6_is_in_range(IPToCheck, prefix)),
    (IPv4ASN | where ipv4_is_in_range(IPToCheck, prefix));
PrefixMatch
| top 1 by mask_length desc
| join kind=leftouter MaliciousASN on asn
| project IP=IPToCheck, Prefix=prefix, ASN=asn, Organization=organization,
    Country=country, BGP_Hits=hits, Malicious=malicious, Confidence=confidence,
    Category=category, IntelSource=source, LastSeen=last_seen;
