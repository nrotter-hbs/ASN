// Sentinel / Kusto example: enrich an IPv6 address with the most-specific
// BGP prefix and its ASN/organization from the GitHub CSV.
let ASNData = externaldata(
    prefix:string,
    network:string,
    mask_length:int,
    ip_version:int,
    asn:string,
    organization:string,
    rir:string,
    country:string,
    hits:long,
    source:string
)[
    "https://raw.githubusercontent.com/nrotter-hbs/ASN/main/data/ipv6_ownership.csv"
]
with (format="csv", ignoreFirstRecord=true);

let IPToCheck = "2607:fb91:44::1";
ASNData
| where ip_version == 6
| where ipv6_is_in_range(IPToCheck, prefix)
| top 1 by mask_length desc
| project IP=IPToCheck, Prefix=prefix, ASN=asn, Organization=organization,
          RIR=rir, Country=country, BGP_Hits=hits, Source=source;
